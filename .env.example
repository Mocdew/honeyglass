# Honeyglass configuration — copy to .env and adjust.
# This file contains PLACEHOLDERS ONLY. Never commit a real .env.
# Honeyglass is read-only: it holds NO seed phrases, private keys, or signers.

# --- Server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Public base URL advertised in the A2A Agent Card (the "url" field).
# Set this on your host, e.g. https://honeyglass.onrender.com
# If left blank, the card falls back to the request's host header.
PUBLIC_URL=

# --- Upstream data sources (third-party, read-only) ---
GOPLUS_BASE_URL=https://api.gopluslabs.io
# Optional GoPlus access token for higher rate limits.
# Leave blank to use the free public tier. This is NOT a wallet key.
GOPLUS_ACCESS_TOKEN=
HONEYPOT_BASE_URL=https://api.honeypot.is

# --- Networking ---
# Hard timeout for each upstream call (ms).
REQUEST_TIMEOUT_MS=8000
# Rate limit per client IP.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# --- Verdict thresholds (balanced defaults; all tunable) ---
# Sell/buy tax at or above *_FAIL_PCT => FAIL. Between CAUTION and FAIL => CAUTION.
SELL_TAX_FAIL_PCT=50
BUY_TAX_FAIL_PCT=50
SELL_TAX_CAUTION_PCT=10
BUY_TAX_CAUTION_PCT=10
# Below these => CAUTION.
MIN_HOLDER_COUNT=50
MIN_LP_LOCKED_PCT=50

# --- ERC-8183 commerce (OPTIONAL; leave disabled for read-only screening) ---
# Turn the agent into a hireable ERC-8183 seller. When enabled, the seller
# wallet signs price quotes and submits deliverables on-chain (BNB testnet).
# Generate the wallet with `npm run gen-wallet` (writes keys here), then fund it.
COMMERCE_ENABLED=false
COMMERCE_NETWORK=bsc-testnet
# Seller wallet — generated by `npm run gen-wallet`. NEVER commit real values.
SELLER_PRIVATE_KEY=
SELLER_WALLET_PASSWORD=
# Price per screen, in the payment token's smallest unit (18 decimals). 0.1 U.
SERVICE_PRICE_RAW=100000000000000000
# Quote validity window in seconds (SDK caps at 900).
QUOTE_TTL_SECONDS=900
# Marketplace category advertised in the Agent Card.
COMMERCE_CATEGORY=security
# Where delivered manifests are persisted so their on-chain URL keeps resolving.
DELIVERABLE_DIR=data/deliverables
